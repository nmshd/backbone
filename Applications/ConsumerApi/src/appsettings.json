{
    "AllowedHosts": "*",
    "OTEL_SERVICE_NAME": "enmeshed.backbone.consumerapi",
    "Authentication": {
        "JwtLifetimeInSeconds": 300
    },
    "ModuleDefaults": {
        "Application": {
            "Pagination": {
                "DefaultPageSize": 50,
                "MaxPageSize": 200
            },
            "Infrastructure": {
                "SqlDatabase": {
                    "EnableHealthCheck": true
                }
            }
        }
    },
    "Modules": {
        "Devices": {
            "Application": {
                "MaxNumberOfFeatureFlagsPerIdentity": 200
            }
        },
        "Messages": {
            "Application": {
                "MaxNumberOfUnreceivedMessagesFromOneSender": 20,
                "MaxNumberOfMessageRecipients": 1
            }
        }
    },
    "Telemetry": {
        "OpenTelemetry": {
            "Logger": {
                "IncludeFormattedMessage": true,
                "IncludeScopes": true,
                "ParseStateValues": true
            }
        },
        "Logging": {
            "MinimumLevel": {
                "Default": "Warning",
                "Override": {
                    "Backbone": "Information",
                    "Azure.Messaging.ServiceBus": "Error"
                }
            },
            "WriteTo": {
                "Console": {
                    "Name": "Console",
                    "Args": {
                        "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                    }
                }
            }
        }
    }
}
