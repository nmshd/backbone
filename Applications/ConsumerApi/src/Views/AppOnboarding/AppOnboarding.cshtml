@model Backbone.ConsumerApi.Controllers.Onboarding.AppOnboardingModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider

@{
    Layout = null;
}

<!DOCTYPE html>
<head>
    <title>Onboarding</title>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const link = document.getElementById('in-app-link');
            if (link) {
                link.href = window.location.toString().replace(/^(https)|(http)/, "@Model.AppId");
            }
        });
    </script>

    <style>
        :root {
            --primary-color: @Model.ColorScheme.Primary;
            --secondary-color: @Model.ColorScheme.Secondary;
            --background-color: @Model.ColorScheme.Background;
            --on-primary-color: @Model.ColorScheme.OnPrimary;
            --on-secondary-color: @Model.ColorScheme.OnSecondary;
        }

        #app-install-step {
            flex-direction: @(Model.Links.Count > 1 ? "column" : "row");
            justify-content: space-between;
        }

        .banner {
            padding: 64px 32px;
        }

        .banner img {
            width: 100%;
        }

        .store-link img {
            height: 40px;
        }

        .app-store-button {
            display: flex;
            align-self: center;
            height: 40px;
        }

        .app-store-buttons {
            display: flex;
            flex-wrap: wrap;
            justify-content: end;
            gap: 16px;
            height: 40px;
        }

        .store-link-missing {
            opacity: 0.3;
        }

        @@media (pointer: coarse), (hover: none) {
            [title] {
                position: relative;
                display: inline-flex;
                justify-content: center;
            }

            [title]:focus::after {
                content: attr(title);
                position: absolute;
                top: 90%;
                background-color: #555;
                color: #fff;
                border: 1px solid;
                width: fit-content;
                padding: 3px;
                font-size: 10px;
            }
        }

        .app-icon {
            display: block;
            width: 60px;
            height: 60px;
            border-radius: 20%;
        }
    </style>

    <link rel="stylesheet" href="~/style/style.css" />
    <link rel="stylesheet" href="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/openid4vp-verifier/assets/verifier.css")" />
    <script type="module" src="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/openid4vp-verifier/assets/verifier.js")"></script>
    <noscript>
        <style>
            body.openid4vp-verifier-visible #openid4vp-verifier-root {
                display: none;
            }

            body.openid4vp-verifier-visible #app-onboarding-content {
                display: block;
            }
        </style>
    </noscript>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body class="openid4vp-verifier-visible">
<div id="openid4vp-verifier-root"
     data-reference-id="@Model.ReferenceId"
     data-token-endpoint-template="/api/v2/Tokens/{id}"
     data-relationship-template-endpoint-template="/api/v2/RelationshipTemplates/{id}">
    <main class="openid4vp-verifier verifier is-loading" aria-label="OpenID4VP Nachweisprüfung" data-verifier>
        <section class="verifier-content" data-verifier-content>
            <p class="intro">
                Ein Nachweis wurde Ihnen präsentiert.<br />
                Überprüfen Sie die Gültigkeit!
            </p>

            <div class="credential-section">
                <section class="pass-card" aria-label="Nachweis" data-credential-card hidden>
                    <img class="pass-logo" alt="" data-credential-logo hidden />
                    <img class="pass-portrait" alt="" data-credential-portrait hidden />
                    <h1 data-credential-title hidden></h1>
                </section>

                <section class="details" aria-label="Nachweisdetails" data-details hidden>
                    <div class="verified-by" data-verified-by hidden>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3 5 6v5c0 4.5 2.8 8.7 7 10 4.2-1.3 7-5.5 7-10V6l-7-3Z" fill="none" stroke="currentColor" stroke-width="1.8" />
                            <path d="m9 12 2 2 4-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span>verifiziert durch <span data-verified-by-issuer></span></span>
                    </div>
                    <dl>
                        <div data-detail-row="issuer" hidden>
                            <dt>Aussteller</dt>
                            <dd data-detail-value="issuer"></dd>
                        </div>
                        <div data-detail-row="createdAt" hidden>
                            <dt>Erstellt</dt>
                            <dd data-detail-value="createdAt"></dd>
                        </div>
                        <div data-detail-row="expiresAt" hidden>
                            <dt>Gültig bis</dt>
                            <dd data-detail-value="expiresAt"></dd>
                        </div>
                        <div data-detail-row="publicKey" hidden>
                            <dt>Public Key</dt>
                            <dd data-detail-value="publicKey"></dd>
                        </div>
                        <div class="additional-claims" data-additional-claims></div>
                    </dl>
                </section>
            </div>

            <section class="result" aria-live="polite">
                <p data-result-text>Der Nachweis<br />wird geprüft.</p>
                <div class="status-mark loading-mark" aria-hidden="true" data-loading-mark></div>
                <div class="status-mark" aria-hidden="true" data-valid-mark hidden>
                    <svg viewBox="0 0 120 120">
                        <path d="M36 62.5 52.5 79 86 40" fill="none" stroke="currentColor" stroke-width="7" />
                    </svg>
                </div>
                <div class="status-mark" aria-hidden="true" data-invalid-mark hidden>
                    <svg viewBox="0 0 120 120">
                        <path d="m43 43 34 34M77 43 43 77" fill="none" stroke="currentColor" stroke-width="7" />
                    </svg>
                </div>
            </section>

            <p class="sr-only" data-error hidden></p>

            <footer class="button-area">
                <button class="close-button" type="button" data-close hidden>Hinweis schließen</button>
            </footer>
        </section>

        <section class="closed-view" aria-live="polite" data-closed-view hidden>
            <p>Sie können dieses Fenster jetzt schließen.</p>
        </section>
    </main>
</div>
<div id="app-onboarding-content">
<div class="container">
    <div class="banner-box">
        <div class="banner">
            <img src="@Model.BannerUrl" alt="@Model.AppDisplayName Logo" />
        </div>
    </div>

    <div class="steps-container">
        <div class="info-box">
            <p>@Model.AppDescription</p>
        </div>

        <div class="step-box" id="app-install-step">
            <div class="step-content numbered-step-content">
                <p>1.</p>
                <p>Laden Sie die @Model.AppDisplayName-App aus dem @Model.AppStoreDescriptor.</p>
            </div>
            <div class="@(Model.Links.Count > 1 ? "app-store-buttons" : "app-store-button")">
                @foreach (var appStore in Model.Links)
                {
                    <a href="@appStore.Link"
                       title="@(string.IsNullOrEmpty(appStore.Link) ? appStore.NoLinkText : null)"
                       tabindex="0"
                       target="_blank"
                       class="store-link"
                       aria-label="@(string.IsNullOrEmpty(appStore.Link) ? appStore.NoLinkText : $@"{appStore.StoreName} öffnen")">
                        <img
                            src="@appStore.StoreButtonUrl"
                            alt="@appStore.StoreName"
                            onclick="document.getElementById('app-install-step').style.backgroundColor ='@Model.ColorScheme.Secondary';
                                     document.querySelector('#app-install-step .step-content').style.color ='@Model.ColorScheme.OnSecondary';"
                            class="@(string.IsNullOrEmpty(appStore.Link) ? "store-link-missing" : null) " />
                    </a>
                }
            </div>
        </div>

        <a class="step-box" id="in-app-link">
            <div class="step-content numbered-step-content">
                <p>2.</p>
                <p>Klicken Sie anschließend hier, um die App mit Ihrem Code zu starten.</p>
            </div>
            <img src="@Model.AppIconUrl" alt="App starten" class="app-icon" />
        </a>
    </div>
</div>
</div>
</body>
